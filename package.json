{
  "name": "email-campaign-react-airtable",
  "version": "1.0.0",
  "description": "",
  "main": "server/dist/index.js",
  "engines": {
    "node": "16.5.0",
    "npm": "7.19.1"
  },
  "scripts": {
    "start": "nodemon --watch server --ext ts --ignore server/dist --exec ts-node server/index.ts",
    "start:prod": "node server/dist/index.js",
    "build:server": "tsc -p server",
    "typecheck": "tsc -p server/tsconfig.test.json && npm run typecheck --prefix client",
    "heroku-postbuild": "npm run build:server && cd client && npm install && npm run build",
    "test": "npm test --prefix server",
    "test:coverage": "npm run test:coverage --prefix server",
    "test:e2e": "npm test --prefix e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emailjs/browser": "^3.3.1",
    "@mui/material": "^5.2.5",
    "axios": "^0.24.0",
    "clsx": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.3",
    "http-proxy-middleware": "^2.0.3",
    "nodemon": "^2.0.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/express-serve-static-core": "^4.17.35",
    "@types/node": "^16.18.126",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
