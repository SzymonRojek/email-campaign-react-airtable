{
  "name": "email-campaign-dashboard",
  "version": "1.0.0",
  "description": "",
  "main": "server/dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "nodemon --watch server --ext ts --ignore server/dist --exec ts-node server/index.ts",
    "start:prod": "node server/dist/index.js",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server",
    "build:client": "cd client && npm install --include=dev && npm run build",
    "typecheck": "tsc -p server/tsconfig.test.json && npm run typecheck --prefix client",
    "test": "npm test --prefix server",
    "test:coverage": "npm run test:coverage --prefix server",
    "test:e2e": "npm test --prefix e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/express-serve-static-core": "^4.17.35",
    "@types/node": "^16.18.126",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
