{
  "info": {
    "name": "Talent Outreach API",
    "description": "API tests of Talent Outreach.\n\n- **Full run** (all folders): only locally / in CI against the fake Airtable (`npm run test:api`).\n- **Smoke (read-only)**: safe on the live demo - the nightly demo reset runs it against production.\n\nSet `baseUrl` and `password` in an environment (see the `postman` folder). The login token is taken by \"Log in\" and never saved in a file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// a unique mark for the data this run creates (e-mails must be unique)",
          "if (!pm.collectionVariables.get(\"runId\")) pm.collectionVariables.set(\"runId\", Date.now());",
          "",
          "// the live demo (onrender.com) uses the real Airtable base - only reading is allowed there,",
          "// so a full run can never change or delete the demo data",
          "const isDemo = /onrender\\.com/.test(pm.variables.get(\"baseUrl\"));",
          "const readsOnly = pm.request.method === \"GET\" || pm.info.requestName === \"Log in\";",
          "if (isDemo && !readsOnly) {",
          "  console.warn(`Skipped on the live demo: ${pm.info.requestName}`);",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "candidateId",
      "value": ""
    },
    {
      "key": "jobOfferId",
      "value": ""
    },
    {
      "key": "emailId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Smoke (read-only)",
      "description": "Safe on the live demo: only reads. The nightly demo reset runs this folder against production.",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the server is ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Log in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const { token } = pm.response.json();",
                  "pm.test(\"returns a login token\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);",
                  "// the next requests use it (collection auth: Bearer {{token}})",
                  "pm.collectionVariables.set(\"token\", token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Candidates",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"the demo has candidates\", () => pm.expect(list).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"every candidate has an id and an e-mail\", () =>",
                  "  list.forEach((s) => pm.expect(s).to.have.property(\"id\") && pm.expect(s.fields.email).to.include(\"@\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candidates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "candidates"
              ]
            }
          }
        },
        {
          "name": "Job offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"the demo has job offers\", () => pm.expect(list).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"every job offer is a draft or sent\", () =>",
                  "  list.forEach((c) => pm.expect([\"draft\", \"sent\"]).to.include(c.fields.status)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/job-offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "job-offers"
              ]
            }
          }
        },
        {
          "name": "Sent e-mails",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"a list of e-mails\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/outbox",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "outbox"
              ]
            }
          }
        },
        {
          "name": "Feedback (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200 without a login\", () => pm.response.to.have.status(200));",
                  "pm.test(\"a list (only approved feedback)\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/feedback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "feedback"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
