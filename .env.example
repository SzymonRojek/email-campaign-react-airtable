# Copy to .env (never commit .env) and fill in the values.
# Only the Express server reads these - the browser never sees them.

# Airtable base ID - from the base's address: airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Airtable personal access token (Airtable -> Builder hub -> Personal access tokens)
# scopes: data.records:read, data.records:write; access: only this base
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# password for the login form
ADMIN_PASSWORD=change-me

# random secret that signs the login tokens, e.g. the output of: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# optional - turns on POST /api/demo/reset, which WIPES the base and puts the example data back.
# Set it only on the production server (and the same value as the DEMO_RESET_KEY secret on GitHub).
# DEMO_RESET_KEY=

# optional - where the e-mails go: "outbox" (default, only saved in the app) or
# "ethereal" (locally: also sent to a test SMTP server, the preview links are logged)
# MAIL_TRANSPORT=outbox

# optional - error monitoring (Sentry): the project's DSN from sentry.io; empty = off
# (normally only on Render; the client build reads it too)
# SENTRY_DSN=
